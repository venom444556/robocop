# Malware Analysis Platform - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Required Configuration
# ===========================================

# Platform API Key (used for authentication)
API_KEY=your-secure-api-key-here

# Anthropic Claude API Key (required for AI analysis)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api-...

# ===========================================
# Optional: Intelligence Enrichment APIs
# ===========================================

# VirusTotal (free: 4 requests/minute)
# Get one at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Shodan (free tier available)
# Get one at: https://account.shodan.io/
SHODAN_API_KEY=

# URLhaus Auth Key (free)
# Get one at: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=

# Google Safe Browsing (free: 10K/day)
# Get one at: https://console.cloud.google.com/
GOOGLE_SAFEBROWSING_API_KEY=

# CheckPhish (free tier)
# Get one at: https://checkphish.ai/
CHECKPHISH_API_KEY=

# IPQualityScore (free: 5K/month)
# Get one at: https://www.ipqualityscore.com/
IPQUALITYSCORE_API_KEY=

# ===========================================
# Optional: AWS S3 Storage
# ===========================================

# AWS Credentials (for S3 artifact storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=malware-analysis-artifacts

# ===========================================
# n8n Configuration
# ===========================================

# n8n Basic Auth
N8N_USER=admin
N8N_PASSWORD=change-this-password

# n8n Encryption Key (generate a random string)
N8N_ENCRYPTION_KEY=your-random-encryption-key

# ===========================================
# Optional: NVD/CVE Intelligence
# ===========================================

# NVD API Key (optional - provides higher rate limits for CVE lookups)
# Without key: 5 requests/30s, with key: 50 requests/30s
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ===========================================
# Optional: Report Settings
# ===========================================

# Default TLP marking for reports (TLP:WHITE, TLP:GREEN, TLP:AMBER, TLP:RED)
# DEFAULT_TLP_MARKING=TLP:AMBER

# ===========================================
# Advanced Configuration
# ===========================================

# CORS Origins (comma-separated list of allowed origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL (default: SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./data/malware_analysis.db

# Upload directory
# UPLOAD_DIR=./uploads

# Claude model to use (default: claude-haiku-4-5-20241022)
# CLAUDE_MODEL=claude-haiku-4-5-20241022

# Report retention days (default: 30)
# REPORT_RETENTION_DAYS=30

# Max file size in bytes (default: 50MB)
# MAX_FILE_SIZE=52428800
